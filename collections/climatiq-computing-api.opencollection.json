        },
        {
          "info": {
            "name": "Estimate cloud memory emissions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.climatiq.io/compute/v1/memory",
            "body": {
              "type": "json",
              "data": "{}"
            }
